

# Layout settings
bar_width = 360;
bar_height = 6;
bar_bottom_margin = 100;

# Load artwork.
background_image = Image("background.png");
bar_background_image = Image("bar-background.png");
bar_fill_image = Image("bar-fill.png");

# Create sprites.
background_sprite = Sprite(background_image);
bar_background_sprite = Sprite(bar_background_image);
bar_fill_sprite = Sprite(bar_fill_image);

# Screen dimensions.
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Center the background artwork.
background_sprite.SetPosition(
    (screen_width - background_image.GetWidth()) / 2,
    (screen_height - background_image.GetHeight()) / 2,
    -100
);

# Center the progress bar horizontally.
bar_x = (screen_width - bar_width) / 2;
bar_y = screen_height - bar_bottom_margin;

bar_background_sprite.SetPosition(bar_x, bar_y, 10);
bar_fill_sprite.SetPosition(bar_x, bar_y, 20);

# Resize the progress fill to match the current progress.
fun update_progress(duration, progress)
    {
        if (progress < 0)
            progress = 0;
        if (progress > 1)
            progress = 1;

        fill_width = Math.Int(bar_width * progress);

        if (fill_width < 1)
            fill_width = 1;

        scaled_fill = bar_fill_image.Scale(fill_width, bar_height);
        bar_fill_sprite.SetImage(scaled_fill);
        bar_fill_sprite.SetPosition(bar_x, bar_y, 20);
    }

# Start with an empty bar.
update_progress(0, 0);
Plymouth.SetBootProgressFunction(update_progress);
# Load and center the logo.
logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

logo_x = (screen_width - logo_image.GetWidth()) / 2;
logo_y = (screen_height - logo_image.GetHeight()) / 2;

logo_sprite.SetPosition(logo_x, logo_y, 0);

